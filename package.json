{
  "name": "opencode-notepad",
  "version": "0.0.1",
  "description": "OpenCode Desktop side-panel notepad, one per chat: Markdown notes with a checklist the coding agent can add to.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "notepad",
    "checklist",
    "markdown"
  ],
  "type": "module",
  "license": "MIT",
  "author": "parzival1l",
  "homepage": "https://github.com/parzival1l/opencode-notepad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parzival1l/opencode-notepad.git"
  },
  "bugs": "https://github.com/parzival1l/opencode-notepad/issues",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test && bun run test:e2e && bun run build",
    "test:e2e": "vite build -c e2e/vite.config.ts && bun test ./e2e"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "puppeteer-core": "^25.16.0",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
