{
  "name": "opencode-notepad",
  "version": "0.1.0",
  "description": "OpenCode Desktop side-panel notepad, one per chat: Markdown notes with a checklist the coding agent can add to.",
  "keywords": ["opencode", "opencode-plugin", "notepad", "checklist", "markdown"],
  "type": "module",
  "license": "MIT",
  "author": "parzival1l",
  "homepage": "https://github.com/parzival1l/opencode-notepad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parzival1l/opencode-notepad.git"
  },
  "bugs": "https://github.com/parzival1l/opencode-notepad/issues",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": ["src", "dist"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  }
}
